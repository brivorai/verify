{
  "name": "@brivora/verify",
  "version": "0.1.0",
  "description": "5 lines of code to make any AI call verifiable. Cryptographic governance proofs for AI compliance.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "format": "biome format --write src/",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "ai-governance",
    "compliance",
    "verification",
    "cryptographic-proof",
    "merkle-tree",
    "eu-ai-act",
    "post-quantum",
    "audit",
    "governance",
    "pqc",
    "tamper-evident"
  ],
  "author": "Brivora, LLC",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/brivorai/verify.git"
  },
  "homepage": "https://brivora.dev/verify",
  "bugs": {
    "url": "https://github.com/brivorai/verify/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "sideEffects": false,
  "packageManager": "pnpm@10.28.2",
  "dependencies": {
    "@brivora/crypto": "^0.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.15",
    "@types/node": "^25.2.3",
    "@vitest/coverage-v8": "^4.0.18",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
